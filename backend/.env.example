# Server
PORT=5000
NODE_ENV=development

# MongoDB — leave MONGO_URI empty to use an in-memory MongoDB for development.
# For a real database, use MongoDB Atlas: mongodb+srv://<user>:<pass>@cluster0.xxxxx.mongodb.net/foodrush
MONGO_URI=

# Auth
JWT_SECRET=please-change-me-to-a-long-random-string
JWT_EXPIRES_IN=7d

# CORS
CLIENT_URL=http://localhost:5173
